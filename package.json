{
  "name": "@tkshsbcue/chronokit",
  "version": "0.1.0",
  "description": "Calendar + resource scheduler in plain JavaScript (ES modules, no framework). Day/week/month/timeline views, drag & drop, recurring events, undo/redo and backend sync.",
  "keywords": [
    "calendar",
    "scheduler",
    "vanilla-js",
    "es-modules",
    "resource-scheduling",
    "timeline",
    "recurring-events",
    "crm"
  ],
  "author": "tkshsbcue",
  "license": "MIT",
  "homepage": "https://github.com/tkshsbcue/ChronoKIT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkshsbcue/ChronoKIT.git"
  },
  "bugs": {
    "url": "https://github.com/tkshsbcue/ChronoKIT/issues"
  },
  "type": "module",
  "main": "./dist/chronokit.umd.js",
  "module": "./dist/chronokit.js",
  "browser": "./dist/chronokit.umd.js",
  "unpkg": "./dist/chronokit.umd.js",
  "jsdelivr": "./dist/chronokit.umd.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/chronokit.umd.js"
    },
    "./core": "./src/core/index.js",
    "./style.css": "./src/styles.css",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "SYNC_PROTOCOL.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "vite --open /demo/",
    "build": "vite build && node -e \"require('fs').copyFileSync('src/styles.css','dist/chronokit.css')\"",
    "build:demo": "vite build --config demo/vite.config.js",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
